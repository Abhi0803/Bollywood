{
  "expo": {
    "name": "Naam Bolo",
    "slug": "naam-bolo",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "naambolo",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abhinav.naambolo",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppleMusicUsageDescription": "Naam Bolo connects to Apple Music so subscribers can play full songs instead of 30-second previews."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.abhinav.naambolo",
      "adaptiveIcon": {
        "backgroundColor": "#ff2d6f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#160828",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "@sentry/react-native",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08d37c8e-818f-46be-828c-dcf9d2e2f5e3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "abhi08nav",
    "updates": {
      "url": "https://u.expo.dev/08d37c8e-818f-46be-828c-dcf9d2e2f5e3",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
