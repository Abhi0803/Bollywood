{
  "expo": {
    "name": "Naam Bolo",
    "slug": "naam-bolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "naambolo",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abhinav.naambolo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppleMusicUsageDescription": "Naam Bolo plays song clips from Apple Music so players can guess the movie."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.abhinav.naambolo",
      "adaptiveIcon": {
        "backgroundColor": "#ff2d6f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#160828",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08d37c8e-818f-46be-828c-dcf9d2e2f5e3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "abhi08nav",
    "updates": {
      "url": "https://u.expo.dev/08d37c8e-818f-46be-828c-dcf9d2e2f5e3",
      "enabled": false,
      "checkAutomatically": "NEVER"
    }
  }
}
