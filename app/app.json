{
  "expo": {
    "name": "Naam Bolo",
    "slug": "naam-bolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "naambolo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#160828"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abhinav.naambolo",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppleMusicUsageDescription": "Naam Bolo plays song clips from Apple Music so players can guess the movie.",
        "UIBackgroundModes": ["audio"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.abhinav.naambolo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ff2d6f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#160828",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "PLACEHOLDER_FILL_AFTER_eas_init"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
