# Supabase — paste real values into a sibling `.env` file (NOT committed).
# Find these in your Supabase project: Settings → API
#
# anon/public key is safe to ship in the app bundle (it's how supabase-js
# authenticates). Real security comes from Row-Level Security policies on
# the database, not from hiding this key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-jwt-here
