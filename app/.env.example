# Supabase — paste real values into a sibling `.env` file (NOT committed).
# Find these in your Supabase project: Settings → API Keys
#
# IMPORTANT for the URL: paste only the base host, e.g.
#   https://xxxxxxxxxxxx.supabase.co
# NOT the REST endpoint with /rest/v1/ appended. supabase-js builds the
# right paths on its own.
#
# Publishable key (was called "anon" in older Supabase) is safe to ship
# in the app bundle. Real security comes from Row-Level Security policies
# on the database, not from hiding this key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx
